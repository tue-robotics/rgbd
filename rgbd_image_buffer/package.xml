<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgbd_image_buffer</name>
  <version>0.1.0</version>
  <description>Buffer which combines RGBD images with TF transformations</description>

  <maintainer email="MatthijsBurgh@outlook.com">Matthijs van der Burgh</maintainer>

  <license>TODO</license>

  <url type="bugtracker">https://github.com/tue-robotics/rgbd/issues</url>
  <url type="repository">https://github.com/tue-robotics/rgbd</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geolib2</depend>
  <depend>geometry_msgs</depend>
  <depend>rgbd</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>clang-format-21</test_depend>
  <test_depend>clang-tidy-21</test_depend>
  <test_depend>tue_lint_config</test_depend>

  <doc_depend>doxygen</doc_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc config="rosdoc.yaml" />
  </export>

</package>
